{
  "name": "agent-dungeon",
  "version": "3.0.0",
  "private": true,
  "description": "Three.js pixel-dungeon shooter: 28 AI agents, 8 sealed sectors, 10 bosses",
  "scripts": {
    "build": "python3 build.py",
    "art": "./tools/art/make_art.sh",
    "icons": "python3 -I tools/art/make_icons.py",
    "art:sheet": "python3 -I tools/art/slice_sheet.py",
    "serve": "python3 -m http.server 8080",
    "test": "node qa/all.js",
    "test:play": "node qa/play.js desktop caret 2 && node qa/play.js mobile claude 1",
    "shots": "node qa/shots.js desktop caret"
  },
  "devDependencies": {
    "pixi.js": "8.6.6",
    "playwright": "1.56.0",
    "three": "0.170.0"
  }
}
